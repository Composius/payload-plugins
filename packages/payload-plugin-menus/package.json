{
  "name": "@composius/payload-plugin-menus",
  "version": "1.2.0",
  "description": "Payload plugin that adds a Menus collection",
  "license": "MIT",
  "author": {
    "name": "Composius"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Composius/payload-plugins",
    "directory": "packages/payload-plugin-menus"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tags": {
      "import": "./src/exports/tags.ts",
      "types": "./src/exports/tags.ts",
      "default": "./src/exports/tags.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf {dist,*.tsbuildinfo}"
  },
  "devDependencies": {
    "@composius/payload-plugin-shared-components": "workspace:*",
    "next": "16.2.6",
    "payload": "3.84.1",
    "rimraf": "3.0.2",
    "tsup": "8.5.0",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "next": "^16.0.0",
    "payload": "^3.84.1"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./tags": {
        "import": "./dist/exports/tags.js",
        "types": "./dist/exports/tags.d.ts",
        "default": "./dist/exports/tags.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
