{
  "name": "@composius/payload-plugin-redirections",
  "version": "0.1.0",
  "description": "Redirections collection with exact, prefix and regex URL matching, plus a Next.js proxy helper",
  "license": "MIT",
  "author": {
    "name": "Composius"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Composius/payload-plugins",
    "directory": "packages/payload-plugin-redirections"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./next": {
      "import": "./src/exports/next.ts",
      "types": "./src/exports/next.ts",
      "default": "./src/exports/next.ts"
    }
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf {dist,*.tsbuildinfo}"
  },
  "devDependencies": {
    "next": "16.2.6",
    "payload": "3.84.1",
    "rimraf": "3.0.2",
    "tsup": "8.5.0",
    "typescript": "5.7.3"
  },
  "peerDependencies": {
    "payload": "^3.84.1"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "exports": {
      ".": {
        "import": "./dist/index.js",
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./next": {
        "import": "./dist/exports/next.js",
        "types": "./dist/exports/next.d.ts",
        "default": "./dist/exports/next.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
